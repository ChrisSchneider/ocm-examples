// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go .
{
	"name": "Go",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.26-trixie",
	"mounts": [
//		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
//		"source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
		"source=${localEnv:HOME}/Library/Application Support/mkcert/rootCA.pem,target=/usr/local/share/ca-certificates/rootCA.crt,type=bind,consistency=cached"
	],
	"runArgs": ["--network=odg-core_devcontainer_default"],
	"features": {
		"ghcr.io/devcontainers/features/node:2.1.0": {
			"version": "22"
		}
	},
    "postCreateCommand": ".devcontainer/install-clis.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code"
			]
		}
	}
}
